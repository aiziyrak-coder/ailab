# Nusxa: copy to backend/.env
# ZiyrakAi (texnik jihatdan OpenAI)
OPENAI_API_KEY=
# Vision: gpt-4o (standart). Tezroq/arzon: gpt-4o-mini
OPENAI_MODEL_ID=gpt-4o

# Tahlil tezligi/sifati (ixtiyoriy)
# OPENAI_MAX_OUTPUT_TOKENS=8192
# OPENAI_IMAGE_MAX_PX=1600
# OPENAI_VIDEO_MAX_FRAMES=6
# OPENAI_TEMPERATURE=0.1
# OPENAI_TOP_P=0.92

# Vaqtinchalik xatolarda qayta urinish (ixtiyoriy)
# OPENAI_MAX_RETRIES=3
# OPENAI_RETRY_DELAY_SEC=2
# OPENAI_TIMEOUT_SEC=120

# Jonli mikroskop oqimi (preview)
# PREVIEW_FPS=25
# PREVIEW_MAX_EDGE=1280
# PREVIEW_JPEG_QUALITY=62

# Jurnal papkasi (bo'sh + DEBUG=0: backend/logs, 5MB x 10 fayl)
# LOG_DIR=
# LOG_LEVEL=INFO

# Ixtiyoriy xato kuzatuv: pip install sentry-sdk
# SENTRY_DSN=
# SENTRY_TRACES=0.05

# Zaxira (python manage.py backup_db)
# BACKUP_DIR=
# BACKUP_KEEP_DAYS=14

DJANGO_SECRET_KEY=ozgartiring-uzun-tasodifiy-qator
DJANGO_DEBUG=1
DJANGO_ENV=development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (bo'sh qoldirilsa SQLite)
# DATABASE_URL=postgresql://user:pass@localhost:5432/medlab
# DB_CONN_MAX_AGE=600

# Sessiya muddati (sekund), standart 8 soat
# SESSION_COOKIE_AGE=28800
# SESSION_SAVE_EVERY_REQUEST=0

# Django admin (/admin/). DEBUG=0 da odatda o'chiq
# DJANGO_ADMIN_ENABLED=0

# Brauzer uchun API bazasi: UI bilan bir xil domen (tavsiya) — nisbiy /api/... chaqiruvlari.
# Bo'sh qoldiring yoki https://ailab.ziyrak.org (o'z domeningiz).
# Alohida faqat API (Postman): https://ailabapi... baribir ishlaydi.
# MEDLAB_PUBLIC_API_BASE=
# MEDLAB_PUBLIC_UI_BASE=https://ailab.ziyrak.org
# SESSION_COOKIE_DOMAIN=.ziyrak.org
# CSRF_COOKIE_DOMAIN=.ziyrak.org
# CORS_ALLOWED_ORIGINS=https://ailab.ziyrak.org
# CSRF_TRUSTED_ORIGINS=https://ailab.ziyrak.org,https://ailabapi.ziyrak.org

# Alohida portda frontend (masalan Live Server 5500):
# CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Tezlik cheklovi (ixtiyoriy)
# THROTTLE_ANALYZE=36/hour
# THROTTLE_CAMERA=180/hour
# THROTTLE_AUTH=45/hour

# Ishlab chiqarish (HTTPS)
# DJANGO_DEBUG=0
# DJANGO_SECURE_SSL_REDIRECT=1
# SESSION_COOKIE_SECURE=1
# SECURE_HSTS_SECONDS=31536000
# SECURE_PROXY_SSL_HEADER=X-Forwarded-Proto,https

# Jurnal
# LOG_LEVEL=INFO

# Asosiy hisob: python manage.py create_demo_user
# Login: 12345

# ─── Bilim bazasi (kitob vektor indeksi) ─────────────────────────────────────
# Indeks papkasi (standart: backend/data/histology_kb)
# HISTOLOGY_KB_DIR=
# Indeksni o'chirish (tahlil kitobsiz ishlaydi): 0
# HISTOLOGY_KB_ENABLED=1
# Har tahlilda olinadigan parcha soni va promptdagi hajmi
# HISTOLOGY_KB_TOP_K=14
# HISTOLOGY_KB_PER_SOURCE=3
# HISTOLOGY_KB_PROMPT_CHARS=11000
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Skanerlangan kitoblarni OCR qilish (ingest skripti)
# KB_OCR_MODEL=gpt-4o-mini
# KB_OCR_DPI=170
# KB_OCR_WORKERS=6
# Tekshiruv/organ aniqlash uchun alohida (tezroq) model — bo'sh bo'lsa asosiy model
# OPENAI_ROUTER_MODEL=gpt-4o-mini

# ─── Deploy (SSH) ────────────────────────────────────────────────────────────
# AILAB_SSH_HOST=192.168.0.101
# AILAB_SSH_USER=admin_root
# Parolsiz kalit (tavsiya):
# AILAB_SSH_KEY=~/.ssh/imentor_deploy
# Kalit bilan kirilsa ham sudo parol so'rashi mumkin:
# AILAB_SUDO_PASSWORD=
# Yoki parol bilan kirish:
# AILAB_SSH_PASSWORD=

# Tahlil sifati bosqichlari (odatda yoqilgan)
# Rasmdan belgi yig'ish (tashxis shu belgilarga bog'lanadi)
# HISTOLOGY_OBSERVE_PASS=1
# Yakuniy professor tekshiruvi (imzo oldidan qayta ko'rik)
# HISTOLOGY_EXPERT_REVIEW=1
# Ko'rik bosqichiga yuboriladigan rasm soni (ko'p rasm diqqatni tarqatadi)
# HISTOLOGY_OBSERVE_IMAGES=8
# Hisobot chaqiruviga yuboriladigan rasm soni (ko'p rasm rad javobiga olib keladi)
# HISTOLOGY_REPORT_IMAGES=10
