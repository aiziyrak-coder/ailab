[Unit]
Description=AILab MedLab Django (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/ailab/backend
EnvironmentFile=-/opt/ailab/backend/.env
ExecStart=/opt/ailab/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8010 \
    --workers 3 \
    --timeout 300 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
