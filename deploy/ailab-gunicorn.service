[Unit]
Description=AILab MedLab Django (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/ailab/backend
EnvironmentFile=-/opt/ailab/backend/.env
# 1 worker: kamera va tahlil xotirasi jarayonlar o'rtasida bo'linmaydi.
# Yuklama oshsa --threads ni oshiring; workers>1 faqat rasm-yuklash (DB poll) uchun.
Environment=GUNICORN_WORKERS=1
ExecStart=/opt/ailab/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8011 \
    --workers 1 \
    --threads 8 \
    --timeout 300 \
    --graceful-timeout 45 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
