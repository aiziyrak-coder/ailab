[Unit]
Description=MedLab Django (lab.fermi.uz)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/lab-fermi/backend
EnvironmentFile=-/opt/lab-fermi/backend/.env
Environment=GUNICORN_WORKERS=1
ExecStart=/opt/lab-fermi/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8011 \
    --workers 1 \
    --threads 8 \
    --timeout 300 \
    --graceful-timeout 45 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
